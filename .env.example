# Project Metadata
PROJECT_NAME="AI Medical Parsing & QA Service"
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"

# Relational Database (SQLite)
# SQLite connection URI. Three slashes indicate a relative path, four slashes indicate absolute.
DATABASE_URL="sqlite:///./sql_app.db"

# NoSQL Database (MongoDB) for LLM QA Generations
# Set connection string for local instance or remote MongoDB cluster
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="medical_ai_db"

# LLM Integration (Google Gemini API)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-1.5-flash"
